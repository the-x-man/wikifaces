{
  "manifest_version": 3,
  "name": "WikiFace: Wikipedia Plot Character Switcher",
  "short_name": "WikiFace",
  "version": "1.0.0",
  "description": "Swap character names in Wikipedia plot summaries for the actors who play them, or for their faces.",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["*://*.wikipedia.org/w/api.php*"],
  "content_scripts": [
    {
      "matches": ["*://*.wikipedia.org/wiki/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
